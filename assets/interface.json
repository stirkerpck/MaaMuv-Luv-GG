{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "MuvLuv GG",
    "description": "Muv-Luv GG 自动探索与装备强化。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MuvLuv GG。",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/stirkerpck/MaaMuv-Luv-GG",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "自动刷图与强化",
            "label": "自动刷图与装备强化",
            "description": "自动探索迷宫，刷满指定轮数后进入装备强化。开始前请先确保已进入游戏。",
            "entry": "NodeA",
            "option": [
                "刷几轮后停"
            ]
        }
    ],
    "option": {
        "刷几轮后停": {
            "type": "input",
            "label": "刷几轮后停",
            "description": "输入探索重复次数，到该次数后停止再进入装备强化。",
            "inputs": [
                {
                    "name": "轮数",
                    "label": "回合数",
                    "default": "50",
                    "pipeline_type": "int",
                    "verify": "^[0-9]+$",
                    "pattern_msg": "请输入非负整数"
                }
            ],
            "pipeline_override": {
                "MuvLuv_MazePrepare": {
                    "max_hit": "{轮数}"
                }
            }
        }
    }
}
